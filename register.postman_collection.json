{
  "info": {
    "name": "Project Management API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Project Management API auth endpoints. Base URL: http://127.0.0.1:8000"
  },
  "item": [
    {
      "name": "Auth",
      "description": "Authentication and profile routes.",
      "item": [
            {
              "name": "Register User",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"first_name\": \"Jane\",\n  \"last_name\": \"Doe\",\n  \"email\": \"jane.doe@example.com\",\n  \"password\": \"StrongPass123!\",\n  \"bio\": \"Product manager with 5 years of experience.\",\n  \"phone_number\": \"5551234567\"\n}"
                },
                "url": {
                  "raw": "http://127.0.0.1:8000/api/register/",
                  "protocol": "http",
                  "host": [
                    "127",
                    "0",
                    "0",
                    "1"
                  ],
                  "port": "8000",
                  "path": [
                    "api",
                    "register"
                  ]
                }
              },
              "response": []
            },
            {
              "name": "Login User",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"jane.doe@example.com\",\n  \"password\": \"StrongPass123!\"\n}"
                },
                "url": {
                  "raw": "http://127.0.0.1:8000/api/login/",
                  "protocol": "http",
                  "host": [
                    "127",
                    "0",
                    "0",
                    "1"
                  ],
                  "port": "8000",
                  "path": [
                    "api",
                    "login"
                  ]
                }
              },
              "response": []
            },
            {
              "name": "Refresh Token",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"refresh\": \"<refresh_token>\"\n}"
                },
                "url": {
                  "raw": "http://127.0.0.1:8000/api/token/refresh/",
                  "protocol": "http",
                  "host": [
                    "127",
                    "0",
                    "0",
                    "1"
                  ],
                  "port": "8000",
                  "path": [
                    "api",
                    "token",
                    "refresh"
                  ]
                }
              },
              "response": []
            },
            {
              "name": "Logout",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Authorization",
                    "value": "Bearer <access_token>",
                    "type": "text"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"refresh\": \"<refresh_token>\"\n}"
                },
                "url": {
                  "raw": "http://127.0.0.1:8000/api/logout/",
                  "protocol": "http",
                  "host": [
                    "127",
                    "0",
                    "0",
                    "1"
                  ],
                  "port": "8000",
                  "path": [
                    "api",
                    "logout"
                  ]
                }
              },
              "response": []
            },
            {
              "name": "Get Profile",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer <access_token>",
                    "type": "text"
                  }
                ],
                "url": {
                  "raw": "http://127.0.0.1:8000/api/profile/",
                  "protocol": "http",
                  "host": [
                    "127",
                    "0",
                    "0",
                    "1"
                  ],
                  "port": "8000",
                  "path": [
                    "api",
                    "profile"
                  ]
                }
              },
              "response": []
            },
            {
              "name": "Update Profile (PUT)",
              "request": {
                "method": "PUT",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Authorization",
                    "value": "Bearer <access_token>",
                    "type": "text"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"first_name\": \"Jane\",\n  \"last_name\": \"Doe\",\n  \"bio\": \"Updated bio.\",\n  \"phone_number\": \"5551234567\"\n}"
                },
                "url": {
                  "raw": "http://127.0.0.1:8000/api/profile/",
                  "protocol": "http",
                  "host": [
                    "127",
                    "0",
                    "0",
                    "1"
                  ],
                  "port": "8000",
                  "path": [
                    "api",
                    "profile"
                  ]
                }
              },
              "response": []
            },
            {
              "name": "Update Profile (PATCH)",
              "request": {
                "method": "PATCH",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Authorization",
                    "value": "Bearer <access_token>",
                    "type": "text"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"bio\": \"Partial update bio.\"\n}"
                },
                "url": {
                  "raw": "http://127.0.0.1:8000/api/profile/",
                  "protocol": "http",
                  "host": [
                    "127",
                    "0",
                    "0",
                    "1"
                  ],
                  "port": "8000",
                  "path": [
                    "api",
                    "profile"
                  ]
                }
              },
              "response": []
            },
            {
              "name": "Change Password",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Authorization",
                    "value": "Bearer <access_token>",
                    "type": "text"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"old_password\": \"StrongPass123!\",\n  \"new_password\": \"NewStrongPass123!\"\n}"
                },
                "url": {
                  "raw": "http://127.0.0.1:8000/api/change-password/",
                  "protocol": "http",
                  "host": [
                    "127",
                    "0",
                    "0",
                    "1"
                  ],
                  "port": "8000",
                  "path": [
                    "api",
                    "change-password"
                  ]
                }
              },
              "response": []
            }
          ]
        }
      ]
    }

